{
  "name": "tca-js",
  "version": "0.3.0",
  "description": "Unofficial TikTok Chat API for JavaScript — read/send TikTok direct messages (text, images, reactions) and listen over websocket using session cookies, no browser needed.",
  "license": "MIT",
  "author": "rice2411",
  "repository": { "type": "git", "url": "git+https://github.com/rice2411/tca-js.git" },
  "homepage": "https://github.com/rice2411/tca-js#readme",
  "bugs": { "url": "https://github.com/rice2411/tca-js/issues" },
  "keywords": ["tiktok", "tiktok-api", "tiktok-dm", "tiktok-chat", "direct-message", "unofficial", "chat", "websocket", "zca-js"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.11",
    "typescript": "5.9.3"
  }
}
